# Normalise line endings so shell and python scripts always run on Linux runners
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.html text
*.css text
*.js text
*.json text
*.md text
*.txt text
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.ico binary
*.doc binary
*.docx binary
